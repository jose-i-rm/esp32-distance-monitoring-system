# Variables para docker compose (copiar como .env en esta carpeta)
DEVICE_API_KEY=cambie-esta-clave
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ADMIN_API_KEY=cambie-esta-clave-admin
# Tuya Cloud: completar SOLO en el .env local (ignorado por git)
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_DEVICE_ID=
TUYA_ENDPOINT=https://openapi.tuyaus.com
TUYA_POLL_INTERVAL_SECONDS=0
