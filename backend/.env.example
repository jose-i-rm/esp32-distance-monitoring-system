# Copiar como .env y ajustar valores. NUNCA subir .env al repositorio.

ENVIRONMENT=development

# PostgreSQL local (docker compose) o URL entregada por Render/Railway/Fly.
DATABASE_URL=postgresql+psycopg://esp32:esp32@localhost:5432/esp32_monitoring
# Alternativa rápida sin PostgreSQL (solo desarrollo):
# DATABASE_URL=sqlite:///./dev.db
# AUTO_CREATE_TABLES=true

# Clave compartida con el firmware (cabecera X-API-Key). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_API_KEY=

# Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

AUTO_CREATE_TABLES=false

# Clave para los endpoints /api/camera/* (cabecera X-API-Key). Sin valor, esos endpoints
# responden 503. Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- Tuya Cloud (cámara PTZ) ---------------------------------------------------------
# Valores en https://platform.tuya.com > Cloud > Development > <proyecto> > Overview.
# NUNCA escribir los valores reales aquí: copiar este archivo como .env (ignorado por git)
# o definirlos en el gestor de secretos de Render/Railway/Fly/GitHub Actions.
TUYA_ACCESS_ID=<tu_access_id>
TUYA_ACCESS_SECRET=<tu_access_secret>
TUYA_DEVICE_ID=<id_de_la_camara>
# Data center del proyecto: us=openapi.tuyaus.com · eu=openapi.tuyaeu.com · cn=openapi.tuyacn.com · in=openapi.tuyain.com
TUYA_ENDPOINT=https://openapi.tuyaus.com
# Sondeo periódico de eventos de la cámara (segundos, mínimo 30; 0 = desactivado)
TUYA_POLL_INTERVAL_SECONDS=0
PTZ_MIN_INTERVAL_SECONDS=1.0
PTZ_MAX_DURATION_MS=3000
