{
  "openapi": "3.1.0",
  "info": {
    "title": "ESP32 Distance Monitoring System",
    "description": "API REST para el registro y consulta de mediciones de distancia capturadas por una ESP32-CAM con sensor ultrasónico HC-SR04.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Salud"
        ],
        "summary": "Estado del servicio",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/measurements": {
      "post": {
        "tags": [
          "Mediciones"
        ],
        "summary": "Registrar una medición",
        "description": "Endpoint consumido por la ESP32-CAM cada 30 segundos.",
        "operationId": "create_measurement_api_v1_measurements_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeasurementCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeasurementRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Mediciones"
        ],
        "summary": "Listar mediciones",
        "description": "Devuelve el historial ordenado de la lectura más reciente a la más antigua.",
        "operationId": "list_measurements_api_v1_measurements_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "description": "Cantidad máxima de registros.",
              "default": 100,
              "title": "Limit"
            },
            "description": "Cantidad máxima de registros."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Desplazamiento para paginación.",
              "default": 0,
              "title": "Offset"
            },
            "description": "Desplazamiento para paginación."
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar desde (ISO 8601).",
              "title": "Start"
            },
            "description": "Filtrar desde (ISO 8601)."
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar hasta (ISO 8601).",
              "title": "End"
            },
            "description": "Filtrar hasta (ISO 8601)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeasurementList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/measurements/latest": {
      "get": {
        "tags": [
          "Mediciones"
        ],
        "summary": "Última medición",
        "operationId": "latest_measurement_api_v1_measurements_latest_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeasurementRead"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "app": {
            "type": "string",
            "title": "App"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "database": {
            "type": "string",
            "title": "Database"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "app",
          "version",
          "environment",
          "database",
          "timestamp"
        ],
        "title": "HealthResponse"
      },
      "MeasurementCreate": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "Momento de la lectura (ISO 8601). Si no incluye zona horaria se asume UTC.",
            "examples": [
              "2026-11-01T16:08:55Z"
            ]
          },
          "distance_cm": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Distance Cm",
            "description": "Distancia medida en centímetros.",
            "examples": [
              214.05
            ]
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "distance_cm"
        ],
        "title": "MeasurementCreate"
      },
      "MeasurementList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MeasurementRead"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "MeasurementList"
      },
      "MeasurementRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "distance_cm": {
            "type": "number",
            "title": "Distance Cm"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "timestamp",
          "distance_cm",
          "created_at"
        ],
        "title": "MeasurementRead"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
